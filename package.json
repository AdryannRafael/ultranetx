{
  "name": "ultranetx",
  "version": "1.0.50",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "bun run --watch src/index.ts",
    "db:migrate": "bun --bun drizzle-kit migrate --config=drizzle.config.ts",
    "db:generate": "bun --bun drizzle-kit generate --config=drizzle.config.ts",
    "db:push": "bun --bun drizzle-kit push --config=drizzle.config.ts",
    "auth:generate": "bun x --bun auth generate --config='src/auth/better-auth.ts' --output='src/db/schema/auth.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.14",
    "@elysia/cors": "^1.4.2",
    "@elysia/openapi": "^1.4.16",
    "@types/pg": "^8.23.1",
    "better-auth": "^1.7.14",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "elysia": "latest",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "bun-types": "latest"
  },
  "module": "src/index.js"
}
